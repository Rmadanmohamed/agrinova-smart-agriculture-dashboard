        "labels": [
          {
            "color": {
              "solid": {
                "color": "#DDEBFF"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#9EB6C9"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#DDEBFF"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#15314A"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#9EB6C9"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#DDEBFF"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#15314A"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#DDEBFF"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "card": {
      "*": {
