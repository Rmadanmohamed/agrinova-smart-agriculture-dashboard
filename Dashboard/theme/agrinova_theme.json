  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#081727"
              }
            },
            "transparency": 12
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1C4664"
              }
            },
            "radius": 8
