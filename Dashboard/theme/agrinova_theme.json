{
  "name": "AgriNova Premium Dark Future",
  "dataColors": [
    "#3DF27A",
    "#00D4FF",
    "#65A7FF",
    "#F8C741",
    "#FF5D5D",
    "#8B5CF6",
    "#2DD4BF",
    "#F97316"
  ],
  "background": "#020B18",
  "foreground": "#DDEBFF",
