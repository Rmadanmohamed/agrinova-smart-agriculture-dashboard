        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#9EB6C9"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#DDEBFF"
              }
            },
            "background": {
              "solid": {
                "color": "#0B1B2D"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#3DF27A"
              }
            },
            "background": {
              "solid": {
                "color": "#071524"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#020B18"
              }
            },
            "transparency": 0
