            },
            "transparency": 55,
            "blur": 12,
            "angle": 45,
            "distance": 3
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#E7F6FF"
